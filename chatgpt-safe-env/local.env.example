# 复制为 local.env 后按需填写（local.env 已被 .gitignore 忽略）

# 允许的 Cloudflare 出口国家/地区代码（逗号分隔，默认 US；支持多地区可写如 US,SG,JP,TW）
CHATGPT_ALLOWED_LOCS=US

# 可选：预期固定出口 IP（若使用静态 ISP / 独享 VPS 落地，填入具体 IP 进行强校验；保留占位符则仅校验地区）
CHATGPT_EXPECTED_IP=REPLACE_WITH_EXPECTED_IP

# macOS 原生 ChatGPT.app 强烈建议开启 Clash Verge TUN 模式（1=强制要求 TUN，0=允许仅系统代理）
CHATGPT_REQUIRE_TUN=1

# 是否允许 Clash Verge 开启 IPv6（0=禁止，防止 IPv6 泄漏或地区漂移；1=允许）
CHATGPT_ALLOW_IPV6=0

# 可选：若未开 TUN 模式，可指定 Clash Verge 本地混杂端口，例如 http://127.0.0.1:7897
# CHATGPT_PROXY_URL=http://127.0.0.1:7897

# 可选：手动指定 Clash Verge Mihomo Unix Socket 或 HTTP API（默认自动探测 /tmp/verge/verge-mihomo.sock）
# CHATGPT_MIHOMO_SOCKET=/tmp/verge/verge-mihomo.sock
# CHATGPT_MIHOMO_API=http://127.0.0.1:9097
# CHATGPT_MIHOMO_SECRET=

# 可选：隔离版 Chrome Profile 目录名（位于 ~/Library/Application Support/Google/<名称>）
# CHATGPT_CHROME_PROFILE_NAME=Chrome-ChatGPT-US

# 可选：设为 1 时仅做安检并启动 ChatGPT.app，不额外拉起隔离版 Chrome
# CHATGPT_SKIP_BROWSER=0
